#!/bin/sh
# pre-push: main ブランチへの直接 push 防止

remote="$1"
url="$2"

z40="0000000000000000000000000000000000000000"

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/master" ]; then
        # 削除の push でないならブロック
        if [ "$local_sha" != "$z40" ]; then
            echo "========================================================"
            echo " [ERROR] Direct push to '$remote_ref' is forbidden!"
            echo " Please push to a topic branch and create a Pull Request."
            echo "   e.g.) git push -u origin feature/001-setup-keystore"
            echo "========================================================"
            exit 1
        fi
    fi
done

exit 0
